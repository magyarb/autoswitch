# Dash0 web monitoring (optional). Telemetry is off when these are empty.
# Endpoint: Dash0 > Organization Settings > Endpoints > "OTLP via HTTP".
# Token: one that can only ingest, ideally restricted to web events and one dataset;
# it is visible to anyone who opens the app.
NUXT_PUBLIC_DASH0_ENDPOINT=
NUXT_PUBLIC_DASH0_AUTH_TOKEN=
NUXT_PUBLIC_DASH0_DATASET=
